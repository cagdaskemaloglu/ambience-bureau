# ─── Sanity ──────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=your_sanity_api_token_here

# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Resend ───────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_ADMIN_EMAIL=admin@yourdomain.com

# ─── PayTR ────────────────────────────────────────────────
# PayTR Mağaza Paneli → Destek & Kurulum → Entegrasyon Bilgileri
PAYTR_MERCHANT_ID=your_paytr_merchant_id_here
PAYTR_MERCHANT_KEY=your_paytr_merchant_key_here
PAYTR_MERCHANT_SALT=your_paytr_merchant_salt_here
# PayTR'de ayrı bir sandbox URL yok — aynı merchant_id ile test_mode=1
# gönderilir, gerçek para çekilmeden tüm akış test edilir. Canlıya
# geçerken bunu 0 yapın.
PAYTR_TEST_MODE=1

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

